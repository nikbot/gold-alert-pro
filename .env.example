PORT=3000
POLL_MS=8000
DATA_DIR=/data/gold-alert-pro
MIN_SIGNAL_SCORE=75
STRONG_SIGNAL_SCORE=75
STRONG_SIGNAL_POLL_MS=120000
STRONG_SIGNAL_COOLDOWN_MIN=120
TARGET_1_PCT=1.5
TARGET_2_PCT=3
STOP_LOSS_PCT=1

# Monetization / Pro subscription
PRO_MONTHLY_IRR=149000
PRO_QUARTERLY_IRR=349000
PRO_YEARLY_IRR=999000
# Example: https://your-payment-page.example/pay?plan={plan}&deviceId={deviceId}
# The URL template must be your own payment gateway/payment page.
PAYMENT_URL_TEMPLATE=
# Optional direct support/donation page
SUPPORT_URL=
# Required to manually activate paid subscriptions from the admin endpoint
ADMIN_KEY=

# Push notifications (optional: if omitted, the server generates and persists VAPID keys in DATA_DIR)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:gold-alert-pro@localhost

# GapGPT AI analysis (set ONLY in Deplexo Environment/Secrets; never put the real key in source)
GAPGPT_BASE_URL=https://api.gapgpt.app/v1
GAPGPT_API_KEY=
GAPGPT_MODEL=gpt-4o-mini
# Optional Iranian 18k gold data providers (keys belong in Deplexo Secrets, never source control)
# Provider order: TGJU URLs -> Servix API (IRR/gram) -> Tindex API (Toman/gram converted to Rial)
TGJU_GOLD_URL=https://www.tgju.org/profile/geram18
SERVIX_GOLD_URL=https://servix.cc/api/v1/assets/GOLD_18_RLS
SERVIX_API_KEY=
TINDEX_GOLD_URL=https://tindex.app/api/public/indicators/precious-metals/GOLD-18K
TINDEX_API_TOKEN=
# Optional TGJU fallback snapshot
TGJU_WORLD_URL=https://www.tgju.org/world-market/currency/profile/geram18

# SMS Premium via IPPanel
# IMPORTANT: put these only in Deplexo Environment/Secrets, never in public JS or ZIP.
IPPANEL_API_KEY=
IPPANEL_FROM=
IPPANEL_ADMIN_PHONE=
IPPANEL_URL=https://edge.ippanel.com/v1/api/send
SMS_PLAN_PRICE_IRR=5000000
SMS_PLAN_DAYS=30
# Send at least every N minutes; significant price changes can trigger earlier.
SMS_ALERT_INTERVAL_MIN=10
SMS_CHANGE_THRESHOLD_PCT=0.25

# IPPanel Pattern codes — placeholders must match your pattern variables exactly
# این سه کد را بعداً که Pattern ساختی از IPPanel بگیر و فقط اینجا در Deplexo وارد کن.
# لازم نیست الان مقدار بدهی.
IPPANEL_PATTERN_CODE_PRICE=PASTE_PRICE_PATTERN_CODE_HERE
IPPANEL_PATTERN_CODE_ADMIN=PASTE_ADMIN_PATTERN_CODE_HERE
IPPANEL_PATTERN_CODE_ACTIVATION=PASTE_ACTIVATION_PATTERN_CODE_HERE

# Live phone notifications: screen updates follow POLL_MS; push is throttled to avoid notification spam.
PUSH_LIVE_INTERVAL_MIN=5
PUSH_LIVE_CHANGE_PCT=0.15

# Live mobile push (rate limited)
LIVE_PUSH_INTERVAL_MS=300000
LIVE_PUSH_CHANGE_PCT=0.25

# Portfolio live risk alerts
PORTFOLIO_ALERT_DROP_PCT=0.6
PORTFOLIO_ALERT_SCORE=70
PORTFOLIO_ALERT_COOLDOWN_MIN=30


# Commercial account/admin controls
SELF_REGISTER_ENABLED=true
ADMIN_SESSION_HOURS=12
USER_SESSION_HOURS=72
# Admin master key. Never expose it to the browser or source code.
ADMIN_KEY=
# Optional JSON feed for macro events. If empty, events are stored in DATA_DIR/economic-events.json.
ECONOMIC_EVENTS_JSON=[]
CORS_ORIGIN=

# Editable payment instructions defaults (admin can override in panel)
PAYMENT_CARD_NUMBER=
PAYMENT_CARD_HOLDER=

GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Live 18K gold price engine (v58.2)
# Primary structured source. Get an API key from Servix and set it in Deplexo secrets.
SERVIX_GOLD_URL=https://servix.cc/api/v1/assets/GOLD_18_RLS
SERVIX_API_KEY=
# Backend market polling interval. Browser receives changes through SSE.
POLL_MS=5000
SERVIX_POLL_MS=1800000
SERVIX_429_COOLDOWN_MS=21600000
TGJU_MIN_REQUEST_MS=5000
SOURCE_DIAGNOSTICS_MS=60000
STALE_THRESHOLD_MS=45000
# Optional fallback token.
TINDEX_API_TOKEN=

# Live 18K gold engine (v59.2)
POLL_MS=8000
TGJU_MIN_REQUEST_MS=8000
TGJU_PARSE_COOLDOWN_MS=20000
# Optional structured TGJU-compatible endpoint returning geram18 value/price/time. Leave empty to use TGJU HTML.
TGJU_JSON_URL=
SERVIX_POLL_MS=1800000
SERVIX_429_COOLDOWN_MS=21600000
STALE_THRESHOLD_MS=60000

# Admin login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# v60 Admin Control Center
ADMIN_COOKIE_NAME=gold_admin_session
PUBLIC_BASE_URL=
# Override these in Deplexo Secrets for production.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_SESSION_HOURS=12

# Gold Alert Pro v61 — Smart Alerts / Decision Room
SMART_ALERT_MAX_PER_DEVICE=12
SMART_ALERT_COOLDOWN_MIN=20
SMART_ALERT_REARM_MIN=30
AI_DECISION_CACHE_MS=30000

# Forgod live market provider — queried FIRST; existing providers are fallback.
FORGOD_BASE_URL=http://api.forgod.qzz.io/api
FORGOD_API_KEY=
FORGOD_TIMEOUT=6000
FORGOD_POLL_MS=8000
